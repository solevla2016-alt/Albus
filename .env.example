DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_DEBUG=True
# В продакшене: домен бэкенда, например albus-api.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.onrender.com,.vercel.app

DATABASE_HOST=localhost
DATABASE_USER=albus
DATABASE_PASSWORD=albus_secret
DATABASE_NAME=albus
DATABASE_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

# В продакшене: адрес фронтенда, например https://albus.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# AI Assistant (GigaChat)
# Авторизация через client_id/client_secret (developers.sber.ru)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Либо вход по логину/паролю Сбер ID
GIGACHAT_USERNAME=
GIGACHAT_PASSWORD=
GIGACHAT_MODEL=GigaChat-Pro:latest
AI_ASSISTANT_USERNAME=AI Assistant

# AI Assistant (GigaChat)
# Авторизация через client_id/client_secret (developers.sber.ru).
# Ключ кодируется в base64(client_id:client_secret) и уходит в Authorization: Basic.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Либо вход по логину/паролю Сбер ID
GIGACHAT_USERNAME=
GIGACHAT_PASSWORD=
# Модели, доступные ключу разработчика: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max.
# Старые имена GigaChat-Pro / GigaChat-Pro:latest отвечают "No such model".
GIGACHAT_MODEL=GigaChat-2-Pro
# Корневой сертификат Минцифры уже встроен в образ, проверка TLS включена.
# Выключать только для локальных экспериментов.
GIGACHAT_VERIFY_SSL=True
AI_ASSISTANT_USERNAME=AI Assistant

# Email: восстановление пароля через SMTP Яндекса
# Основной пароль приложения Яндекс.Почты — https://yandex.ru/support/yandex-360/customers/mail/ru/mail-client/clients/others.html
YANDEX_MAIL_USERNAME=
YANDEX_MAIL_PASSWORD=
YANDEX_MAIL_FROM=
YANDEX_MAIL_FROM_NAME=Albus
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
# Адрес фронтенда (используется в ссылке из письма)
FRONTEND_URL=http://localhost:3000
